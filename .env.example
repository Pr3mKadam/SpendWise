# ─── SpendWise Environment Variables ────────────────────────────────────
# WARNING: Never commit real secrets to version control.
# For production, set these in your hosting platform's environment (Vercel/Netlify/Supabase).
#
# ─── REQUIRED: Supabase (for cloud sync, auth, AI proxy) ───────────────
# Create a free project at https://supabase.com
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── OPTIONAL: Gemini AI (for AI features) ─────────────────────────────
# In production, configure GEMINI_API_KEY in Supabase Edge Function secrets.
# Local fallback key (dev only, never use production key here):
# VITE_GEMINI_API_KEY=your-gemini-api-key

# ─── OPTIONAL: Razorpay Payment Gateway ────────────────────────────────
# Configure RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET in Supabase Edge Function secrets.
# The proxy URL is auto-detected from VITE_SUPABASE_URL + /functions/v1/razorpay-proxy

# ─── OPTIONAL: Setu Account Aggregator ─────────────────────────────────
# Configure SETU_CLIENT_ID and SETU_CLIENT_SECRET in Supabase Edge Function secrets.
# Never expose these in client-side code.
# SETU_ENV: 'sandbox' | 'production'
# VITE_SETU_ENV=sandbox
# VITE_SETU_WEBHOOK_URL=https://your-domain.com/api/setu-webhook

# ─── OPTIONAL: Push Notifications (VAPID) ──────────────────────────────
# Generate: npx web-push generate-vapid-keys
# Then set these secrets in Supabase:
#   supabase secrets set VAPID_PUBLIC_KEY=<public-key>
#   supabase secrets set VAPID_PRIVATE_KEY=<private-key>
#   supabase secrets set VAPID_SUBJECT=mailto:admin@spendwise.app
# And set this in .env.local:
# VITE_VAPID_PUBLIC_KEY=<public-key>

# ─── OPTIONAL: Plaid (US bank linking) ─────────────────────────────────
# VITE_PLAID_CLIENT_ID=your-plaid-client-id

# ─── OPTIONAL: Sentry Error Tracking ───────────────────────────────────
# Create a project at https://sentry.io and paste the DSN here.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_LOG_LEVEL=INFO  # DEBUG | INFO | WARN | ERROR

# ─── FEATURE FLAGS ─────────────────────────────────────────────────────
# VITE_DEMO_MODE=true
